# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Google AI Studio key (server-side only, never exposed to the client)
GEMINI_API_KEY=
# Main model (see docs/data-notes.md). Empty = gemini-3.5-flash-lite
GEMINI_MODEL=
# Backup model, used when the main one is out of quota (429), overloaded (503) or slow. Empty = gemini-3.8-flash; "none" = off
GEMINI_FALLBACK_MODEL=
# Email used in the Nominatim User-Agent header
NOMINATIM_CONTACT=
