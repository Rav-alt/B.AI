# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Google AI Studio key (server-side only, never exposed to the client)
GEMINI_API_KEY=
# Current free-tier Flash model ID (see docs/data-notes.md)
GEMINI_MODEL=
# Email used in the Nominatim User-Agent header
NOMINATIM_CONTACT=
